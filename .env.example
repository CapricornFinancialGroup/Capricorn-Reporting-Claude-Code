# Capricorn Growth OS — local development settings. Copy to .env (never commit .env).
# In production these are App Service application settings (see docs/deployment.md).

# --- Data source: the Capricorn Fabric lakehouse share (read-only, rebuilt nightly ~03:15 UTC) ---
FABRIC_SQL_ENDPOINT=t43woyvlppeu7nhsptsxhz7zwq-43nhrvmg2hze7j3vqn2euun35u.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=GAGold_Capricorn

# Local dev auth: `az login` with an account that can read the GlobalAnalyticsShare workspace;
# the mssql driver's azure-active-directory-default picks up the az-cli credential.
# In production the App Service managed identity is used (granted Viewer on the workspace).

# --- Easy Auth bypass for local dev (production resolves X-MS-CLIENT-PRINCIPAL headers) ---
DEV_USER_EMAIL=you@smartr365.com

# --- Kiosk surface (/screens + /api/kiosk) — unset = kiosk disabled (401), never open by accident ---
REPORTING_KIOSK_TOKEN=

# --- Cadence ---
REPORTING_REFRESH_SECONDS=60
REPORTING_CYCLE_SECONDS=20
REPORTING_TIMEZONE=Europe/London

# Pacing model: mtd = month-to-date chase at day granularity (honest for a daily lake).
# "drip" (reserved, not implemented in v1) would spread the latest day's events across a synthetic
# working day for an intraday feel.
PACING_MODE=mtd

# Server-side dataset cache TTL — N wall TVs polling at 60s share ~1 Fabric query per dataset.
REPORTING_CACHE_TTL_SECONDS=45

# --- Weekly targets upload (item 1, 2026-07-07) ---
# Emails allowed to upload/mutate targets, comma-separated, case-insensitive. Empty = upload
# disabled (fails CLOSED, unlike the open-by-default kiosk/ops shape elsewhere in this app).
TARGETS_ADMIN_EMAILS=
# Blob storage account holding the `weekly-targets` container (raw upload + parsed JSON audit +
# the `current.json` pointer). Empty = hydrate/upload disabled; falls back to the
# domain/targets.ts placeholders, same as before this feature existed. Auth is
# DefaultAzureCredential (the app's managed identity in production, `az login` locally) — same
# pattern as the Fabric SQL pool, no new auth idiom. Local dev typically leaves this empty unless
# you specifically need to test the upload path (your own az-cli identity needs its own Storage
# Blob Data Contributor grant on the account — the app's managed identity grant doesn't cover you).
TARGETS_STORAGE_ACCOUNT=
