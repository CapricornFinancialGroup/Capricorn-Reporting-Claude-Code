{
  "name": "capricorn-growth-os",
  "version": "0.1.0",
  "description": "Capricorn Growth OS — wall-dashboard/kiosk over the GAGold_Capricorn Fabric lakehouse",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "fastify": "^5.2.0",
    "mssql": "^12.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
